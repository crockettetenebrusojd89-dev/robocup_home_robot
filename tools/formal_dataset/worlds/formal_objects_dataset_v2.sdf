<?xml version="1.0"?>
<sdf version="1.8">
  <world name="formal_objects_dataset_v2">
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- A low fixed base plus two dynamically configured directional lights
         gives every sample Gazebo-rendered key and ambient-fill variation. -->
    <scene>
      <ambient>0.18 0.18 0.18 1</ambient>
      <background>0.55 0.60 0.66 1</background>
      <shadows>true</shadows>
    </scene>
    <light type="directional" name="sun">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.45 0.20 -0.87</direction>
      <intensity>1.0</intensity>
      <cast_shadows>true</cast_shadows>
    </light>
    <light type="directional" name="ambient_fill">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.7 0.75 0.8 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>0.25 -0.15 -0.96</direction>
      <intensity>0.18</intensity>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Four isolated table/background islands. Their centers must match the
         V2 config; 20 m separation prevents another island entering view. -->
    <model name="background_warm_wood">
      <static>true</static>
      <link name="floor"><pose>0 0 -0.04 0 0 0</pose><visual name="visual"><geometry><box><size>8 8 0.08</size></box></geometry><material><ambient>0.31 0.29 0.25 1</ambient><diffuse>0.42 0.39 0.34 1</diffuse></material></visual></link>
      <link name="table"><pose>0 0 0.72 0 0 0</pose><visual name="visual"><geometry><box><size>1.2 0.8 0.06</size></box></geometry><material><ambient>0.40 0.23 0.11 1</ambient><diffuse>0.58 0.35 0.18 1</diffuse></material></visual></link>
      <link name="wall"><pose>2.5 0 1.3 0 0 0</pose><visual name="visual"><geometry><box><size>0.10 6 2.6</size></box></geometry><material><ambient>0.55 0.49 0.41 1</ambient><diffuse>0.68 0.61 0.52 1</diffuse></material></visual></link>
    </model>
    <model name="background_light_wood">
      <pose>20 0 0 0 0 0</pose><static>true</static>
      <link name="floor"><pose>0 0 -0.04 0 0 0</pose><visual name="visual"><geometry><box><size>8 8 0.08</size></box></geometry><material><ambient>0.43 0.42 0.38 1</ambient><diffuse>0.58 0.56 0.50 1</diffuse></material></visual></link>
      <link name="table"><pose>0 0 0.72 0 0 0</pose><visual name="visual"><geometry><box><size>1.2 0.8 0.06</size></box></geometry><material><ambient>0.62 0.48 0.29 1</ambient><diffuse>0.78 0.62 0.39 1</diffuse></material></visual></link>
      <link name="wall"><pose>2.5 0 1.3 0 0 0</pose><visual name="visual"><geometry><box><size>0.10 6 2.6</size></box></geometry><material><ambient>0.69 0.69 0.64 1</ambient><diffuse>0.82 0.82 0.76 1</diffuse></material></visual></link>
    </model>
    <model name="background_neutral_gray">
      <pose>40 0 0 0 0 0</pose><static>true</static>
      <link name="floor"><pose>0 0 -0.04 0 0 0</pose><visual name="visual"><geometry><box><size>8 8 0.08</size></box></geometry><material><ambient>0.26 0.29 0.31 1</ambient><diffuse>0.37 0.40 0.43 1</diffuse></material></visual></link>
      <link name="table"><pose>0 0 0.72 0 0 0</pose><visual name="visual"><geometry><box><size>1.2 0.8 0.06</size></box></geometry><material><ambient>0.42 0.44 0.45 1</ambient><diffuse>0.56 0.58 0.59 1</diffuse></material></visual></link>
      <link name="wall"><pose>2.5 0 1.3 0 0 0</pose><visual name="visual"><geometry><box><size>0.10 6 2.6</size></box></geometry><material><ambient>0.43 0.49 0.53 1</ambient><diffuse>0.56 0.62 0.66 1</diffuse></material></visual></link>
    </model>
    <model name="background_dark_wood">
      <pose>60 0 0 0 0 0</pose><static>true</static>
      <link name="floor"><pose>0 0 -0.04 0 0 0</pose><visual name="visual"><geometry><box><size>8 8 0.08</size></box></geometry><material><ambient>0.18 0.17 0.16 1</ambient><diffuse>0.27 0.25 0.23 1</diffuse></material></visual></link>
      <link name="table"><pose>0 0 0.72 0 0 0</pose><visual name="visual"><geometry><box><size>1.2 0.8 0.06</size></box></geometry><material><ambient>0.20 0.12 0.08 1</ambient><diffuse>0.31 0.19 0.12 1</diffuse></material></visual></link>
      <link name="wall"><pose>2.5 0 1.3 0 0 0</pose><visual name="visual"><geometry><box><size>0.10 6 2.6</size></box></geometry><material><ambient>0.30 0.26 0.24 1</ambient><diffuse>0.40 0.35 0.32 1</diffuse></material></visual></link>
    </model>

    <!-- The class order and one-based Gazebo labels mirror classes.json. -->
    <include><uri>model://apple</uri><name>apple</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>1</label></plugin></include>
    <include><uri>model://banana</uri><name>banana</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>2</label></plugin></include>
    <include><uri>model://beer</uri><name>beer</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>3</label></plugin></include>
    <include><uri>model://bleach_cleanser</uri><name>bleach_cleanser</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>4</label></plugin></include>
    <include><uri>model://bowl</uri><name>bowl</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>5</label></plugin></include>
    <include><uri>model://chips_can</uri><name>chips_can</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>6</label></plugin></include>
    <include><uri>model://coke_can</uri><name>coke_can</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>7</label></plugin></include>
    <include><uri>model://cracker_box</uri><name>cracker_box</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>8</label></plugin></include>
    <include><uri>model://gelatin_box</uri><name>gelatin_box</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>9</label></plugin></include>
    <include><uri>model://master_chef_can</uri><name>master_chef_can</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>10</label></plugin></include>
    <include><uri>model://mustard_bottle</uri><name>mustard_bottle</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>11</label></plugin></include>
    <include><uri>model://pitcher_base</uri><name>pitcher_base</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>12</label></plugin></include>
    <include><uri>model://potted_meat_can</uri><name>potted_meat_can</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>13</label></plugin></include>
    <include><uri>model://pudding_box</uri><name>pudding_box</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>14</label></plugin></include>
    <include><uri>model://sugar_box</uri><name>sugar_box</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>15</label></plugin></include>
    <include><uri>model://tomato_soup_can</uri><name>tomato_soup_can</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>16</label></plugin></include>
    <include><uri>model://tuna_fish_can</uri><name>tuna_fish_can</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>17</label></plugin></include>
    <include><uri>model://windex_bottle</uri><name>windex_bottle</name><static>true</static><pose>0 0 -5 0 0 0</pose><plugin filename="ignition-gazebo-label-system" name="ignition::gazebo::systems::Label"><label>18</label></plugin></include>

    <model name="training_camera">
      <static>true</static><pose>-1.5 0 1.05 0 0.15 0</pose>
      <link name="link">
        <sensor name="rgb" type="camera"><topic>/training/rgb</topic><camera><horizontal_fov>1.2217304764</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.20</near><far>10.0</far></clip></camera><always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize></sensor>
        <sensor name="visible_boxes" type="boundingbox_camera"><topic>/training/boxes</topic><camera><box_type>visible_2d</box_type><horizontal_fov>1.2217304764</horizontal_fov><image><width>640</width><height>480</height></image><clip><near>0.20</near><far>10.0</far></clip></camera><always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize></sensor>
      </link>
    </model>
  </world>
</sdf>
