<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Official Franka description-only macro.  gazebo=false intentionally avoids
       legacy transmissions and all arm controllers in this integration stage. -->
  <xacro:include filename="$(find franka_description)/robots/common/franka_robot.xacro"/>
  <xacro:include filename="$(find franka_hardware)/ros2_control/franka_arm.ros2_control.xacro"/>

  <!-- Override only the interface-list helper consumed below so the active
       simulation starts in the already validated navigation-stowed posture. -->
  <xacro:macro name="configure_arm_joints" params="joint_prefix include_effort_command:=1">
    <xacro:configure_arm_joint joint_name="${joint_prefix}_joint1" initial_position="-0.68" include_effort_command="${include_effort_command}"/>
    <xacro:configure_arm_joint joint_name="${joint_prefix}_joint2" initial_position="0.29" include_effort_command="${include_effort_command}"/>
    <xacro:configure_arm_joint joint_name="${joint_prefix}_joint3" initial_position="-0.26" include_effort_command="${include_effort_command}"/>
    <xacro:configure_arm_joint joint_name="${joint_prefix}_joint4" initial_position="-2.91" include_effort_command="${include_effort_command}"/>
    <xacro:configure_arm_joint joint_name="${joint_prefix}_joint5" initial_position="0.75" include_effort_command="${include_effort_command}"/>
    <xacro:configure_arm_joint joint_name="${joint_prefix}_joint6" initial_position="1.03" include_effort_command="${include_effort_command}"/>
    <xacro:configure_arm_joint joint_name="${joint_prefix}_joint7" initial_position="2.00" include_effort_command="${include_effort_command}"/>
  </xacro:macro>

  <xacro:macro name="box_inertial" params="mass x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}" ixy="0" ixz="0"
        iyy="${mass * (x * x + z * z) / 12.0}" iyz="0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="mass radius length">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        ixy="0" ixz="0"
        iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        iyz="0" izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- A passive spring lock keeps the description-only arm at its navigation
       stowed reference in Gazebo while retaining the official link masses and
       gravity.  This is only a static preview aid, not an actuator or a
       ros2_control interface. -->
  <xacro:macro name="passive_joint_lock" params="joint reference stiffness">
    <gazebo reference="${joint}">
      <implicitSpringDamper>true</implicitSpringDamper>
      <springReference>${reference}</springReference>
      <springStiffness>${stiffness}</springStiffness>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="mobile_manipulator_static" params="arm_control:=false controller_config:=''">
    <material name="shell_white">
      <color rgba="0.88 0.90 0.94 1.0"/>
    </material>
    <material name="body_graphite">
      <color rgba="0.12 0.15 0.20 1.0"/>
    </material>
    <material name="accent_blue">
      <color rgba="0.08 0.42 0.82 1.0"/>
    </material>

    <!-- V2 low cover: layered visuals conceal the test-platform look while the
         single collision remains inside the existing chassis footprint. -->
    <link name="base_cover_link">
      <xacro:box_inertial mass="0.7" x="0.48" y="0.38" z="0.04"/>
      <visual>
        <origin xyz="0 0 0.0025" rpy="0 0 0"/>
        <geometry><box size="0.48 0.38 0.035"/></geometry>
        <material name="shell_white"/>
      </visual>
      <visual>
        <origin xyz="0 0 -0.0175" rpy="0 0 0"/>
        <geometry><box size="0.45 0.35 0.015"/></geometry>
        <material name="body_graphite"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.34 0.28 0.01"/></geometry>
        <material name="accent_blue"/>
      </visual>
      <collision>
        <geometry><box size="0.48 0.38 0.04"/></geometry>
      </collision>
    </link>
    <joint name="base_cover_joint" type="fixed">
      <parent link="base_link"/>
      <child link="base_cover_link"/>
      <origin xyz="0 0 0.09" rpy="0 0 0"/>
    </joint>

    <!-- The equipment bay remains aft of the lidar scan origin.  A narrow
         shoulder stage creates a gradual body-to-arm transition. -->
    <link name="upper_body_link">
      <xacro:box_inertial mass="1.8" x="0.30" y="0.30" z="0.14"/>
      <visual>
        <origin xyz="0 0 -0.01" rpy="0 0 0"/>
        <geometry><box size="0.30 0.30 0.12"/></geometry>
        <material name="body_graphite"/>
      </visual>
      <visual>
        <origin xyz="0 0.151 -0.005" rpy="0 0 0"/>
        <geometry><box size="0.24 0.012 0.11"/></geometry>
        <material name="shell_white"/>
      </visual>
      <visual>
        <origin xyz="0 -0.151 -0.005" rpy="0 0 0"/>
        <geometry><box size="0.24 0.012 0.11"/></geometry>
        <material name="shell_white"/>
      </visual>
      <visual>
        <origin xyz="0.151 0 -0.005" rpy="0 0 0"/>
        <geometry><box size="0.012 0.20 0.09"/></geometry>
        <material name="accent_blue"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.055" rpy="0 0 0"/>
        <geometry><box size="0.28 0.28 0.03"/></geometry>
        <material name="shell_white"/>
      </visual>
      <collision>
        <geometry><box size="0.30 0.30 0.14"/></geometry>
      </collision>
    </link>
    <joint name="upper_body_joint" type="fixed">
      <parent link="base_cover_link"/>
      <child link="upper_body_link"/>
      <origin xyz="-0.09 0 0.135" rpy="0 0 0"/>
    </joint>

    <link name="shoulder_link">
      <xacro:box_inertial mass="0.7" x="0.24" y="0.26" z="0.07"/>
      <visual>
        <geometry><box size="0.24 0.26 0.055"/></geometry>
        <material name="shell_white"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.035" rpy="0 0 0"/>
        <geometry><box size="0.18 0.20 0.018"/></geometry>
        <material name="accent_blue"/>
      </visual>
      <collision>
        <geometry><box size="0.24 0.26 0.07"/></geometry>
      </collision>
    </link>
    <joint name="shoulder_joint" type="fixed">
      <parent link="upper_body_link"/>
      <child link="shoulder_link"/>
      <origin xyz="0 0 0.105" rpy="0 0 0"/>
    </joint>

    <link name="pedestal_link">
      <xacro:cylinder_inertial mass="0.8" radius="0.085" length="0.04"/>
      <visual>
        <geometry><cylinder radius="0.085" length="0.035"/></geometry>
        <material name="body_graphite"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.018" rpy="0 0 0"/>
        <geometry><cylinder radius="0.088" length="0.008"/></geometry>
        <material name="accent_blue"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.085" length="0.04"/></geometry>
      </collision>
    </link>
    <joint name="pedestal_joint" type="fixed">
      <parent link="shoulder_link"/>
      <child link="pedestal_link"/>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
    </joint>

    <link name="arm_mount_link">
      <xacro:cylinder_inertial mass="0.6" radius="0.11" length="0.02"/>
      <visual>
        <geometry><cylinder radius="0.11" length="0.02"/></geometry>
        <material name="shell_white"/>
      </visual>
      <visual>
        <geometry><cylinder radius="0.085" length="0.022"/></geometry>
        <material name="accent_blue"/>
      </visual>
      <collision>
        <geometry><cylinder radius="0.11" length="0.02"/></geometry>
      </collision>
    </link>
    <joint name="arm_mount_joint" type="fixed">
      <parent link="pedestal_link"/>
      <child link="arm_mount_link"/>
      <!-- The compact arm folds toward -Y.  A small 55 mm counter-offset keeps
           the complete stowed assembly's lateral COM near the chassis center. -->
      <origin xyz="0 0.055 0.03" rpy="0 0 0"/>
    </joint>

    <!-- Enclosed V2 sensor mast and rear camera housing.  The real camera is
         still attached to base_link, so camera_link and optical TF stay frozen. -->
    <link name="camera_mast_link">
      <xacro:box_inertial mass="0.45" x="0.055" y="0.085" z="0.47"/>
      <visual>
        <geometry><box size="0.05 0.08 0.45"/></geometry>
        <material name="body_graphite"/>
      </visual>
      <visual>
        <origin xyz="0.026 0 0" rpy="0 0 0"/>
        <geometry><box size="0.008 0.055 0.38"/></geometry>
        <material name="accent_blue"/>
      </visual>
      <collision>
        <geometry><box size="0.055 0.085 0.47"/></geometry>
      </collision>
    </link>
    <joint name="camera_mast_joint" type="fixed">
      <parent link="upper_body_link"/>
      <child link="camera_mast_link"/>
      <origin xyz="0.27 0 0.38" rpy="0 0 0"/>
    </joint>

    <link name="camera_head_link">
      <xacro:box_inertial mass="0.15" x="0.04" y="0.16" z="0.10"/>
      <visual>
        <geometry><box size="0.04 0.16 0.10"/></geometry>
        <material name="shell_white"/>
      </visual>
      <visual>
        <origin xyz="0 0 0.055" rpy="0 0 0"/>
        <geometry><box size="0.07 0.17 0.02"/></geometry>
        <material name="body_graphite"/>
      </visual>
      <visual>
        <origin xyz="0.025 0 0" rpy="0 0 0"/>
        <geometry><box size="0.01 0.12 0.065"/></geometry>
        <material name="accent_blue"/>
      </visual>
      <collision>
        <geometry><box size="0.04 0.16 0.10"/></geometry>
      </collision>
    </link>
    <joint name="camera_head_joint" type="fixed">
      <parent link="camera_mast_link"/>
      <child link="camera_head_link"/>
      <origin xyz="-0.03 0 0.305" rpy="0 0 0"/>
    </joint>

    <!-- Empty connected_to prevents the upstream macro from defining a second
         copy of arm_mount_link.  The fixed mounting joint below is ours. -->
    <xacro:franka_robot
      robot_type="fr3"
      hand="true"
      ee_id="franka_hand"
      rpy_ee="0 0 ${-pi / 4.0}"
      gazebo="${arm_control}"
      with_sc="false"
      no_prefix="false"
      arm_prefix=""
      description_pkg="franka_description"
      connected_to=""/>

    <joint name="arm_mount_to_fr3_joint" type="fixed">
      <parent link="arm_mount_link"/>
      <child link="fr3_link0"/>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
    </joint>

    <xacro:unless value="${arm_control}">
      <!-- Frozen base-task path: keep the already validated passive stowed arm. -->
      <xacro:passive_joint_lock joint="fr3_joint1" reference="-0.68" stiffness="7000.0"/>
      <xacro:passive_joint_lock joint="fr3_joint2" reference="0.29" stiffness="7000.0"/>
      <xacro:passive_joint_lock joint="fr3_joint3" reference="-0.26" stiffness="7000.0"/>
      <xacro:passive_joint_lock joint="fr3_joint4" reference="-2.91" stiffness="7000.0"/>
      <xacro:passive_joint_lock joint="fr3_joint5" reference="0.75" stiffness="7000.0"/>
      <xacro:passive_joint_lock joint="fr3_joint6" reference="1.03" stiffness="7000.0"/>
      <xacro:passive_joint_lock joint="fr3_joint7" reference="2.00" stiffness="7000.0"/>
      <xacro:passive_joint_lock joint="fr3_finger_joint1" reference="0.0" stiffness="800.0"/>
      <xacro:passive_joint_lock joint="fr3_finger_joint2" reference="0.0" stiffness="800.0"/>
    </xacro:unless>

    <xacro:if value="${arm_control}">
      <!-- Stage 2A opt-in path: reuse the controller-tested Franka Gazebo
           hardware chain. The spawn generator replaces the upstream ready
           initial values with the validated navigation-stowed values. -->
      <xacro:franka_arm_ros2_control
          robot_type="fr3"
          include_effort_command="true"
          include_finger_joint="true"
          arm_prefix="">
        <hardware_plugin>
          <plugin>franka_gazebo_hardware/FrankaGazeboHardwareInterface</plugin>
        </hardware_plugin>
      </xacro:franka_arm_ros2_control>
      <gazebo>
        <plugin filename="gz_ros2_control-system"
                name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>${controller_config}</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

    <!-- Publish the complete mobile-base and arm state in both modes.  The ROS
         relay applies stowed offsets only for the passive base-task path. -->
    <gazebo>
      <plugin filename="ignition-gazebo-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>/model/robocup_home_robot/joint_state</topic>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
